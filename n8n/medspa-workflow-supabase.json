{
  "name": "Simple Med Spa CRM — WhatsApp + Gemini AI + Supabase",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-med-spa",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook_whatsapp",
      "name": "📱 WhatsApp Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "notes": "Listen for incoming WhatsApp messages. Endpoint: http://localhost:5678/webhook/whatsapp-med-spa"
    },
    {
      "parameters": {
        "assignments": {
          "customerPhone": "={{$json.body.From}}",
          "messageText": "={{$json.body.Body}}",
          "timestamp": "={{new Date().toISOString()}}",
          "messageId": "={{$json.body.MessageSid || Math.random().toString(36).substr(2,9)}}"
        }
      },
      "id": "extract_message_data",
      "name": "🧠 Extract Message Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {
          "queryParameters": {
            "key": "AIzaSyAZVUzAT9WijspHLsMVYtVqkIR3uZnJhnk"
          }
        },
        "sendBody": true,
        "bodyParametersJson": {
          "contents": [
            {
              "parts": [
                {
                  "text": "={{$json.messageText}}"
                }
              ]
            }
          ],
          "system_instruction": {
            "parts": [
              {
                "text": "You are a professional medical spa receptionist AI for Lumière Med Spa. Be warm, professional, and focused ONLY on med spa services.\n\n=== MED SPA SERVICES ===\nBotox: $14/unit (typical 20-40 units = $280-450)\nDermal Fillers: $650-950\nHydraFacial: $280\nVI Chemical Peel: $350\nLaser Skin Resurfacing: $650\nMicroneedling: $380\nMicroneedling + PRP: $580\nLip Filler: $480\nLaser Hair Removal: Variable by area\nRF Skin Tightening: $420\nConsultation: Free\n\n=== LOCATION & HOURS ===\nAddress: 45 Blossom Avenue, Suite 200\nHours: Mon-Sat 9AM-7PM, Sun 10AM-5PM\nPhone: (555) 000-5678\n\n=== BOOKING FLOW ===\n1. Ask what treatment they're interested in\n2. Suggest a date/time (offer available slots if you have them)\n3. Ask for confirmation: \"Are you sure you want to book [Treatment] on [Date] at [Time]?\"\n4. When they confirm with YES/CONFIRM/OK → respond: \"✓ Booking confirmed! We look forward to seeing you. Arrive 10 mins early.\"\n5. If they say NO → ask \"What else can I help you with?\"\n\n=== RULES ===\n- Only discuss med spa services\n- If asked about non-spa services, politely redirect: \"I'm here to help with med spa services. Can I assist with that?\"\n- Always be professional and warm\n- Keep responses concise (2-3 sentences max)\n- Never discuss pricing of other clinics\n- Always confirm details before considering booking confirmed\n- When booking is confirmed, the system will automatically save the appointment\n\n=== IMPORTANT ===\nYou MUST extract and mention these details in confirmation:\n- Client Name (ask if not mentioned)\n- Phone Number (they're texting from this)\n- Treatment Name\n- Preferred Date & Time\nExample: \"Great! I've booked Sarah for Botox on Tuesday at 2:00 PM. See you then!\"\n"
              }
            ]
          }
        }
      },
      "id": "call_gemini_api",
      "name": "🤖 Call Google Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ],
      "notes": "Send message to Gemini with med spa system prompt. Replace YOUR_GEMINI_API_KEY with actual API key from ai.google.dev"
    },
    {
      "parameters": {
        "assignments": {
          "aiResponse": "={{$json.candidates[0].content.parts[0].text}}",
          "bookingConfirmed": "={{$json.candidates[0].content.parts[0].text.toLowerCase().includes('booking confirmed') || $json.candidates[0].content.parts[0].text.toLowerCase().includes('confirmed!')}}"
        }
      },
      "id": "parse_gemini_response",
      "name": "📄 Parse Gemini Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.bookingConfirmed}}",
              "value2": true
            }
          ]
        }
      },
      "id": "check_booking_confirmed",
      "name": "✓ Is Booking Confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "notes": "Routes to database save if 'booking confirmed' appears in response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO appointments (phone_number, client_name, treatment, appointment_date, status, gemini_notes, created_at) VALUES ($1, $2, $3, $4, $5, $6, $7)",
        "options": {},
        "queryParametersJson": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{$json.customerPhone}}"
            },
            {
              "name": "name",
              "value": "={{$json.messageText.match(/name is ([A-Za-z ]+)/i)?.[1] || 'Unknown'}}"
            },
            {
              "name": "treatment",
              "value": "={{$json.messageText.match(/(botox|filler|hydrafacial|peel|laser|microneedling|prp|consultation)/i)?.[1] || 'Not specified'}}"
            },
            {
              "name": "date",
              "value": "={{$json.timestamp}}"
            },
            {
              "name": "status",
              "value": "Booked"
            },
            {
              "name": "notes",
              "value": "={{$json.messageText}}"
            },
            {
              "name": "timestamp",
              "value": "={{$json.timestamp}}"
            }
          ]
        }
      },
      "id": "save_to_supabase",
      "name": "💾 Save to Supabase PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1100,
        200
      ],
      "notes": "Only executes if booking_confirmed = true. Saves appointment details to Supabase PostgreSQL DB"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/1093698253829228/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParametersJson": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{$json.customerPhone}}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": {
                "body": "={{$json.aiResponse}}"
              }
            }
          ]
        }
      },
      "id": "send_whatsapp_response",
      "name": "📤 Send Response via WhatsApp Cloud API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        400
      ],
      "notes": "Send Gemini's response back to customer via WhatsApp Cloud API"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"received\",\"message_id\":\"{{$json.messageId}}\",\"booking_confirmed\":{{$json.bookingConfirmed}}}"
      },
      "id": "webhook_response",
      "name": "✔️ Webhook Response (200 OK)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ],
      "notes": "Send 200 OK back to WhatsApp so it confirms receipt"
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-med-spa",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook_whatsapp_verification",
      "name": "📱 WhatsApp Webhook (Verification)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        100
      ],
      "notes": "Listen for Meta verification challenge."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/plain"
              }
            ]
          }
        }
      },
      "id": "respond_webhook_verification",
      "name": "Respond Webhook Verification",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        300,
        100
      ]
    }
  ],
  "connections": {
    "webhook_whatsapp": {
      "main": [
        [
          {
            "node": "extract_message_data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "extract_message_data": {
      "main": [
        [
          {
            "node": "call_gemini_api",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "call_gemini_api": {
      "main": [
        [
          {
            "node": "parse_gemini_response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "parse_gemini_response": {
      "main": [
        [
          {
            "node": "check_booking_confirmed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check_booking_confirmed": {
      "main": [
        [
          {
            "node": "save_to_supabase",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "send_whatsapp_response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "save_to_supabase": {
      "main": [
        [
          {
            "node": "send_whatsapp_response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "send_whatsapp_response": {
      "main": [
        [
          {
            "node": "webhook_response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook_whatsapp_verification": {
      "main": [
        [
          {
            "node": "respond_webhook_verification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [
    "med-spa",
    "whatsapp",
    "gemini-ai",
    "crm",
    "supabase",
    "zero-cost"
  ],
  "_notes": {
    "description": "Simple med spa CRM workflow with WhatsApp Cloud API, Google Gemini AI, and Supabase PostgreSQL",
    "setup_required": [
      "1. Get Google Gemini API key from ai.google.dev (free tier: 60 req/min)",
      "2. Set up WhatsApp Business API via Meta Cloud (https://developers.facebook.com/apps/)",
      "3. Create Supabase project and run schema.sql to create tables",
      "4. Replace {{YOUR_GEMINI_API_KEY}} and {{YOUR_WHATSAPP_BUSINESS_PHONE_ID}}",
      "5. In n8n: Credentials → Add Postgres credential with Supabase host/db/user/password",
      "6. In Meta Cloud: Set webhook URL to http://your-local-ip:5678/webhook/whatsapp-med-spa",
      "7. n8n runs on http://localhost:5678 (Docker or Direct install)"
    ],
    "database_setup": "Run db/schema.sql in Supabase SQL Editor to create 'clients' and 'appointments' tables",
    "costs": "$0/month (free tier: Gemini 60 req/min, WhatsApp Business API free tier, Supabase free tier, n8n self-hosted free)"
  }
}