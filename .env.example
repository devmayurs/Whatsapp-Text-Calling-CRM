# ── Server ───────────────────────────────────────────────────────
NODE_ENV=development          # change to: production
PORT=3001                     # change to whatever port your host assigns (e.g. Render uses PORT automatically)

# ── Database (Supabase PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── n8n Webhook ──────────────────────────────────────────────────
# Dev:  your ngrok URL  (e.g. https://xxxx.ngrok-free.app)
# Prod: your real domain (e.g. https://api.yourdomain.com)
WEBHOOK_URL=https://your-ngrok-or-domain.com

# ── CORS ─────────────────────────────────────────────────────────
# Dev:  *  (allow all)
# Prod: your exact frontend URL (e.g. https://crm.yourdomain.com)
CORS_ORIGIN=*
